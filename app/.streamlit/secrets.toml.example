# Arquivo de exemplo de segredos do Streamlit
# Para configurar localmente, copie este arquivo para secrets.toml
# No Streamlit Cloud ou Render, configure em "Advanced Settings -> Secrets" ou via variável DATABASE_URL.
# Exemplo de configuração da Aiven:
# [connections.postgresql]
# url = "postgresql://fomento_analyst:SuaSenha@host:porta/fomento_db?sslmode=require"
